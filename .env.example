# Copy to .env and fill in. Never commit .env.
# Prime directives (AGENTS.md): open source only, no paid licences; everything
# runs offline. No setting here may point at a cloud model API.
# Keys are added here by the task card that first needs them.

# Large files can live on another drive. On Windows, for example:
#   MODELS_DIR=D:/models
#   DATA_DIR=D:/campus-ai/data
#   NEO4J_DATA=D:/campus-ai/neo4j
# Docker's own images and build cache (~12 GB) move separately (Docker Desktop's
# Disk image location, or Docker Engine's data-root); see the build guide.

# Host directory with local model weights, shared across projects. P7.
# Default ./models. Layout: <MODELS_DIR>/<org>/<model>, e.g. google/embeddinggemma-2
MODELS_DIR=
# Optional, only for the one-time `fetch-models` download.
HF_TOKEN=

# Optional NVIDIA GPU for the model services (embed, api): add compose.gpu.yaml.
# Separator is ";" with Docker Desktop on Windows, ":" on Linux and WSL. Leave
# unset without a GPU: everything also runs on the CPU. The GPU needs NVIDIA's free
# proprietary runtime, a named exception to prime directive 1 (see AGENTS.md).
# COMPOSE_FILE=compose.yaml;compose.gpu.yaml

# Neo4j password for the local graph (P5). Neo4j sits on an internal Docker
# network with no published ports; default campus-ai-local. Set it before the
# first `docker compose up`, since Neo4j keeps the password it started with.
NEO4J_PASSWORD=

# Europeana API key for `fetch-europeana` (R8). Sent only to api.europeana.eu,
# in a request header. Get one at https://pro.europeana.eu/page/get-api
EUROPEANA_API_KEY=

# Host folder for harvested collections (items.jsonl + media). Default ./data.
DATA_DIR=
# Neo4j's data: a Docker volume (default neo4j-data) or a host folder. Changing
# it starts an empty graph; re-run `graph_search.py index` afterwards.
NEO4J_DATA=

# Port for the collections search UI (R9), bound to localhost only. Default 8080.
WEB_PORT=

# LLM router (campus_ai/core/llm). Claude runs on AWS Bedrock in-region.
# AWS credentials come from the standard AWS chain (AWS_PROFILE, or
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or an instance role).
# AWS_PROFILE=
# Bedrock region for Canadian data (region "ca").
CAMPUS_AI_BEDROCK_REGION_CA=ca-central-1
# Bedrock region for EU data (region "eu").
CAMPUS_AI_BEDROCK_REGION_EU=eu-central-1
# Ollama server for the local fallback (region "local").
OLLAMA_HOST=http://localhost:11434
